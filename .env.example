# ==============================================================================
# Thunder Look — Konfiguracja portalu dystrybucyjnego i testowego (root)
# Skopiuj jako .env (NIGDY nie commituj .env do repozytorium!)
# ==============================================================================

# Host i port lokalnego serwera (domyślnie wyłącznie 127.0.0.1:3000)
HOST="127.0.0.1"
PORT="3000"

# Opcjonalny token autoryzacyjny dla endpointów /api/* (jeśli pusty, generowany losowo przy każdym starcie)
THUNDER_LOOK_API_TOKEN=""

# Dozwolony zewnętrzny origin CORS (np. adres podglądu webowego; lokalne 127.0.0.1/localhost są zawsze dozwolone)
APP_URL=""

# Opcjonalna konfiguracja Firebase Auth (logowanie Google w przeglądarce w portalu webowym).
# Alternatywnie skopiuj firebase-applet-config.example.json -> firebase-applet-config.json (plik jest w .gitignore).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

