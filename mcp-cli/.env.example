# ==============================================================================
# Thunder Look MCP Server & CLI — Konfiguracja środowiska
# Skopiuj ten plik jako `.env` i uzupełnij swoimi danymi.
# NIGDY nie commituj pliku `.env` z hasłami do repozytorium.
# ==============================================================================

# Ścieżka do Twojego sejfu Obsidian (np. w OneDrive) — brak wartości na sztywno
OBSIDIAN_VAULT_PATH=""

# Ścieżka do pliku polityki bezpieczeństwa i reguł AI (skopiuj ai-policy.example.json -> ai-policy.json)
THUNDER_LOOK_POLICY_PATH="./ai-policy.json"

# Konfiguracja serwera IMAP
# Przykłady:
#   Roundcube / Hosting: IMAP_HOST="trinitec.pl" (lub "mail.trinitec.pl"), IMAP_PORT="993", IMAP_SECURE="true"
#   Gmail:               IMAP_HOST="imap.gmail.com", IMAP_PORT="993", IMAP_SECURE="true"
#   Outlook / M365:      IMAP_HOST="outlook.office365.com", IMAP_PORT="993", IMAP_SECURE="true"
IMAP_HOST="trinitec.pl"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_STRICT_TLS="true"

# Konfiguracja serwera SMTP
#   Roundcube / Hosting: SMTP_HOST="trinitec.pl", SMTP_PORT="465", SMTP_SECURE="true"
#   Gmail:               SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_SECURE="true"
#   Outlook / M365:      SMTP_HOST="smtp.office365.com", SMTP_PORT="587", SMTP_SECURE="false"
SMTP_HOST="trinitec.pl"
SMTP_PORT="465"
SMTP_SECURE="true"

# Dane logowania do skrzynki pocztowej
# Dla Gmail: podaj 16-znakowe Hasło aplikacji Google (bez spacji)
MAIL_USER="twoj.adres@domena.pl"
MAIL_PASSWORD=""
MAIL_FROM_NAME="Piotr Świerk"

# Nazwy folderów wewnątrz Vaulta Obsidian (względem OBSIDIAN_VAULT_PATH)
VAULT_PROJECTS_DIR="11 - Notes - Trinitec Projekty"
VAULT_ARCHIVE_DIR="12 - Notes - Trinitec Archiwum"
VAULT_CONTACTS_DIR="11 - Notes - Trinitec Projekty/kontakty"
VAULT_ASSETS_DIR="_Assets"

# Opcjonalnie: nazwa folderu IMAP do filtrowania (np. INBOX/Do-Vaulta)
IMAP_ALLOWLIST_FOLDER=""
