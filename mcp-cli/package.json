{
  "name": "thunder-look-mcp-cli",
  "version": "1.0.0",
  "author": "Piotr Świerk",
  "description": "Thunder Look MCP Server (stdio) i CLI (Roundcube / Gmail / Outlook IMAP+SMTP + Obsidian Vault, zero kluczy API AI)",
  "type": "module",
  "main": "dist/mcp-cli/src/mcpServer.js",
  "bin": {
    "thunder-look": "./dist/mcp-cli/src/cli.js",
    "thunder-look-mcp": "./dist/mcp-cli/src/mcpServer.js",
    "trinitec-mail": "./dist/mcp-cli/src/cli.js",
    "trinitec-mail-mcp": "./dist/mcp-cli/src/mcpServer.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev:mcp": "tsx src/mcpServer.ts",
    "dev:cli": "tsx src/cli.ts",
    "start:mcp": "node dist/mcp-cli/src/mcpServer.js",
    "start:cli": "node dist/mcp-cli/src/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "imapflow": "^1.0.184",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.10.0",
    "turndown": "^7.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
